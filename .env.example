# Google AI Studio — Gemma 4 31B (ambos agentes, vía Gemini API)
MODEL=gemini/gemma-4-31b-it
GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=your_google_api_key

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qa-crew
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=1

# API
MAX_CONCURRENT_JOBS=1
JOBS_WORKSPACE_ROOT=/tmp/jobs

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://qa:qa@postgres:5432/qa

# Ollama (alternativa local; comentar Gemini arriba si usás esto)
# OLLAMA_BASE_URL=http://100.126.36.101:11434
# API_BASE=http://100.126.36.101:11434
# MODEL=ollama/qwen3:14b
